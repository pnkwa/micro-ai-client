{
    "name": "micro-ai-client",
    "version": "0.7.0",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "//dev:https": "Same dev server over HTTPS on the LAN. getUserMedia (the in-app camera and its zoom) only runs in a secure context, so a phone on http://<lan-ip> can never open it. Self-signed: iOS Safari warns once, then Show Details -> visit. The /api proxy is unaffected, since that hop happens server-side.",
        "dev:https": "nuxt dev --host --https",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint:eslint": "eslint .",
        "lint:check-prettier": "prettier --check .",
        "lint:prettier": "prettier --write --list-different .",
        "lint:fix": "pnpm lint:prettier && pnpm lint:eslint --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "nuxt typecheck",
        "//release": "GitHub Releases mirrored from CHANGELOG.md (FE-ADR-009). release:check reports drift and exits non-zero; release:backfill publishes every tag that has none yet.",
        "release:notes": "bash scripts/gh-release.sh notes",
        "release:publish": "bash scripts/gh-release.sh publish",
        "release:backfill": "bash scripts/gh-release.sh backfill",
        "release:check": "bash scripts/gh-release.sh check",
        "prepare": "husky"
    },
    "dependencies": {
        "@fontsource/sarabun": "^5.3.0",
        "@internationalized/date": "3.12.2",
        "@lucide/vue": "^1.31.0",
        "@nuxt/fonts": "^0.14.0",
        "@pinia/nuxt": "^0.11.3",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/vue-table": "^8.21.3",
        "@vee-validate/nuxt": "^4.15.1",
        "@vee-validate/zod": "^4.15.1",
        "@vueuse/integrations": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.21",
        "jwt-decode": "^4.0.0",
        "nuxt": "^4.5.2",
        "nuxt-svgo": "4.2.6",
        "radix-vue": "^1.9.17",
        "reka-ui": "^2.10.3",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.41",
        "vue-sonner": "^2.0.9",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^20.5.3",
        "@nuxt/eslint": "^1.17.0",
        "@vueuse/core": "^14.4.0",
        "@vueuse/nuxt": "^14.4.0",
        "commitlint": "^20.5.3",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.6",
        "sass-embedded": "^1.102.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.9"
    },
    "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
    "pnpm": {
        "overrides": {
            "@internationalized/date": "3.12.2"
        }
    }
}
